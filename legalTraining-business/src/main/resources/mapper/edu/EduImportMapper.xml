<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.legaltraining.business.edu.mapper.EduImportMapper">

    <resultMap type="EduImportBatch" id="EduImportBatchResult">
        <id     property="batchId"     column="batch_id"     />
        <result property="bizType"     column="biz_type"     />
        <result property="termId"      column="term_id"      />
        <result property="classId"     column="class_id"     />
        <result property="fileName"    column="file_name"    />
        <result property="filePath"    column="file_path"    />
        <result property="totalRows"   column="total_rows"   />
        <result property="successRows" column="success_rows" />
        <result property="updateRows"  column="update_rows"  />
        <result property="failRows"    column="fail_rows"    />
        <result property="status"      column="status"       />
        <result property="previewJson" column="preview_json" />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="finishTime"  column="finish_time"  />
    </resultMap>

    <resultMap type="EduImportRow" id="EduImportRowResult">
        <id     property="id"         column="id"          />
        <result property="batchId"    column="batch_id"    />
        <result property="rowNo"      column="row_no"      />
        <result property="rawData"    column="raw_data"    />
        <result property="result"     column="result"      />
        <result property="failReason" column="fail_reason" />
    </resultMap>

    <sql id="selectBatchVo">
        select batch_id, biz_type, term_id, class_id, file_name, file_path,
               total_rows, success_rows, update_rows, fail_rows, status,
               preview_json, create_by, create_time, finish_time
        from edu_import_batch
    </sql>

    <insert id="insertBatch" parameterType="EduImportBatch" useGeneratedKeys="true" keyProperty="batchId">
        insert into edu_import_batch (biz_type, term_id, class_id, file_name, file_path,
                                      total_rows, success_rows, update_rows, fail_rows, status,
                                      preview_json, create_by, create_time)
        values (#{bizType}, #{termId}, #{classId}, #{fileName}, #{filePath},
                #{totalRows}, #{successRows}, #{updateRows}, #{failRows}, #{status},
                #{previewJson}, #{createBy}, sysdate())
    </insert>

    <update id="updateBatch" parameterType="EduImportBatch">
        update edu_import_batch
        <set>
            <if test="totalRows != null">total_rows = #{totalRows},</if>
            <if test="successRows != null">success_rows = #{successRows},</if>
            <if test="updateRows != null">update_rows = #{updateRows},</if>
            <if test="failRows != null">fail_rows = #{failRows},</if>
            <if test="status != null">status = #{status},</if>
            <if test="previewJson != null">preview_json = #{previewJson},</if>
            <if test="finishTime != null">finish_time = #{finishTime},</if>
        </set>
        where batch_id = #{batchId}
    </update>

    <select id="selectBatchById" parameterType="Long" resultMap="EduImportBatchResult">
        <include refid="selectBatchVo"/>
        where batch_id = #{batchId}
    </select>

    <select id="selectBatchList" parameterType="EduImportBatch" resultMap="EduImportBatchResult">
        <include refid="selectBatchVo"/>
        <where>
            <if test="bizType != null and bizType != ''">and biz_type = #{bizType}</if>
            <if test="termId != null">and term_id = #{termId}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by batch_id desc
    </select>

    <delete id="deleteRowsByBatch" parameterType="Long">
        delete from edu_import_row where batch_id = #{batchId}
    </delete>

    <insert id="batchInsertRows">
        insert into edu_import_row (batch_id, row_no, raw_data, result, fail_reason) values
        <foreach collection="list" item="it" separator=",">
            (#{it.batchId}, #{it.rowNo}, #{it.rawData}, #{it.result}, #{it.failReason})
        </foreach>
    </insert>

    <select id="selectRows" resultMap="EduImportRowResult">
        select id, batch_id, row_no, raw_data, result, fail_reason
        from edu_import_row
        where batch_id = #{batchId}
        <if test="result != null">and result = #{result}</if>
        order by row_no
    </select>

</mapper>
